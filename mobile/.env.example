# Django API base URL (no trailing slash). Leave unset to use the defaults:
#   Expo Go on a device -> http://<Metro host>:8000, Android emulator -> http://10.0.2.2:8000, others -> http://localhost:8000
EXPO_PUBLIC_API_URL=
# Next.js web app URL, used for share links and https deep links (e.g. https://chousei.example.com)
EXPO_PUBLIC_WEB_URL=
