# Docker Compose (development) environment variables
# cp .env.docker.example .env   (the .env file is git-ignored)

# Required - generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Optional
DEBUG=True
POSTGRES_DB=scheduling_db
POSTGRES_USER=scheduling
INTERNAL_API_TOKEN=dev-internal-token

# Calendar integrations (RFC-0001 / RFC-0002) - leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Keycloak SSO (RFC-0011) - start with: docker compose --profile sso up
# Set both URLs to enable SSO in the API and the frontend
KEYCLOAK_URL=
NEXT_PUBLIC_KEYCLOAK_URL=
# e.g. KEYCLOAK_URL=http://keycloak:8080/keycloak  NEXT_PUBLIC_KEYCLOAK_URL=http://localhost/keycloak
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_BACKEND_SECRET=
