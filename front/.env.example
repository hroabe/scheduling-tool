# ===== Next.js environment variables =====
# Copy to .env.local for local development.

# Django API origin used by the browser (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical public URL of this site (used for canonical/OGP/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=日程調整ツール
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TWITTER_HANDLE=
# Search Console / Bing Webmaster verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server-only: API URL reachable from the Next.js server (SSR metadata)
API_INTERNAL_URL=http://localhost:8000
INTERNAL_API_TOKEN=
