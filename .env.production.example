# ===== Production settings for docker-compose.prod.yml =====
# cp .env.production.example .env.production  (never commit the real file)

# Public domain (DNS A/AAAA record must point to this server; ports 80/443 open)
DOMAIN=example.com

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Shared secret between Next.js (SSR metadata) and Django (bypasses anon throttling)
INTERNAL_API_TOKEN=

# Optional
POSTGRES_DB=scheduling_db
POSTGRES_USER=scheduling
DJANGO_ADMIN_URL=admin/
WEB_CONCURRENCY=3

# SEO / branding (baked into the frontend at build time)
SITE_NAME=日程調整ツール
CONTACT_EMAIL=
TWITTER_HANDLE=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ----- Optional: async worker (docker compose --profile worker) -----
# REDIS_URL=redis://redis:6379/0

# ----- E-mail (notifications, 1-on-1 booking verification) -----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Encryption key for OAuth tokens (derived from DJANGO_SECRET_KEY when empty)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ----- Optional: calendar integrations -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ----- Optional: Keycloak SSO (docker compose --profile sso) -----
# KEYCLOAK_URL=http://keycloak:8080/keycloak
# NEXT_PUBLIC_KEYCLOAK_URL=https://example.com/keycloak
# KEYCLOAK_IDP_HINT=google
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BACKEND_SECRET=
