# ===== Django API environment variables =====
# Copy to api/.env for local development.

# Never enable DEBUG in production
DEBUG=True
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite is used when omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/scheduling_db

# Frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:3000

# Shared secret with the Next.js server (SSR metadata bypasses anon throttling)
INTERNAL_API_TOKEN=

# Rate limits
THROTTLE_ANON_RATE=100/hour
THROTTLE_EDIT_KEY_RATE=30/hour
# Number of reverse proxies in front of the API (e.g. 1 behind Caddy/Render)
NUM_PROXIES=

# Production only
SECURE_SSL_REDIRECT=True
DJANGO_ADMIN_URL=admin/

DEFAULT_TIMEZONE=Asia/Tokyo

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# OAuth Credentials (RFC-0001, RFC-0002)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/zoom/callback
