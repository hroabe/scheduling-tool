# ===== Production settings for docker-compose.prod.yml =====
# cp .env.production.example .env.production  (never commit the real file)

# Public domain (DNS A/AAAA record must point to this server; ports 80/443 open)
DOMAIN=example.com

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Shared secret between Next.js (SSR metadata) and Django (bypasses anon throttling)
INTERNAL_API_TOKEN=

# Optional
POSTGRES_DB=scheduling_db
POSTGRES_USER=scheduling
DJANGO_ADMIN_URL=admin/
WEB_CONCURRENCY=3

# SEO / branding (baked into the frontend at build time)
SITE_NAME=日程調整ツール
CONTACT_EMAIL=
TWITTER_HANDLE=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
